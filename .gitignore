# =============================================================================
# jchess .gitignore (Security, Toolchain & Artifacts)
# =============================================================================

# --- 1. Security & Environment Variables (비밀정보 및 환경 변수) ---
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.pkcs12
*.p12
*.jks
*.crt
*secret*.properties
*secret*.yml
*secret*.yaml
application-local-override.properties
application-secrets.properties

# --- 2. Database & Data Storage (임베디드 DB 및 덤프 파일) ---
*.h2.db
*.mv.db
*.trace.db
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz

# --- 3. External Chess Binaries & Executables (Stockfish 바이너리 등) ---
stockfish*
*.exe
*.dll
*.so
*.dylib
*.bin
# Gradle wrapper 스크립트는 예외적으로 포함
!backend/gradlew
!backend/gradlew.bat
!backend/gradle/wrapper/gradle-wrapper.jar

# --- 4. Java / Spring Boot / Gradle (백엔드 빌드 산출물) ---
backend/.gradle/
backend/build/
backend/out/
backend/bin/
backend/.settings/
backend/.classpath
backend/.project
backend/.factorypath
target/
build/
out/
bin/
*.class
*.jar
*.war
*.ear
hs_err_pid*.log
replay_pid*.log

# --- 5. Node.js / React 19 / Vite (프론트엔드 빌드 산출물) ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.tmp/
dist/
*.tsbuildinfo
.eslintcache
.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 6. Logs & Temporary Files (로그 및 임시 파일) ---
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*~

# --- 7. IDE & Operating System (개발 도구 및 OS 캐시) ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

